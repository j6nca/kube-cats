# Defaults for local development (`npm start` / `npm run build`).
#
# Create React App only reads a .env from the project root (this directory) and
# only exposes variables prefixed with REACT_APP_. Both were wrong previously,
# which is why none of these ever took effect.
#
# These are build-time only. Deployed containers are configured at runtime
# through the same keys without the prefix - see docker-entrypoint.sh.
# Use .env.local for personal overrides; it is gitignored.

REACT_APP_API_URL=http://localhost:8001
REACT_APP_MAX_PODS=200
REACT_APP_REFRESH_INTERVAL_MS=300000
REACT_APP_HEAT_THRESHOLD=0.8
REACT_APP_SHOW_LABELS=true
REACT_APP_SHOW_POD_COUNT=true
REACT_APP_SHOW_TOOLTIPS=false
REACT_APP_SHOW_FIRE=true
